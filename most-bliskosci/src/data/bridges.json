  "bridges": [
    { "id": "B01", "number": 1, "level": "01", "caption": "Poznajcie się trochę bliżej." },
    { "id": "B02", "number": 2, "level": "02", "caption": "Czas na to, co pod powierzchnią." },
    { "id": "B03", "number": 3, "level": "03", "caption": "Dalej jest szczerość. Nie spieszcie się." },
    { "id": "B04", "number": 4, "level": "04", "caption": "Zbliżcie się. Bez pośpiechu." },
    { "id": "B05", "number": 5, "level": "05", "caption": "To, co wybierzecie, zostanie z wami." }
  ]
}
